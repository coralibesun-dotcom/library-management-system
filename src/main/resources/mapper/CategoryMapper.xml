<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.coraline.library.mapper.CategoryMapper">
    <select id="findAll" resultType="Category">
        select *
        from category
    </select>

    <select id="findById" resultType="Category">
        select *
        from category
        where id = #{id}
    </select>

    <insert id="insert">

        INSERT INTO category
        ( name,
        create_time,
        update_time  )
        VALUES
        ( #{name},
        NOW(),
        NOW()    )

    </insert>

    <update id="update">

        UPDATE category
        SET
        name = #{name},
        update_time = NOW()
        WHERE id = #{id}

    </update>

    <delete id="delete">

        DELETE FROM category
        WHERE id = #{id}

    </delete>
</mapper>
