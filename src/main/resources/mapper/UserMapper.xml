<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.coraline.library.mapper.UserMapper">

    <insert id="insert">

        INSERT INTO user
        (
        username,
        password,
        role,
        status,
        create_time,
        update_time
        )
        VALUES
        (
        #{username},
        #{password},
        #{role},
        #{status},
        NOW(),
        NOW()
        )

    </insert>


    <select id="findByUsername" resultType="User">
        select *
        from user
        where username = #{username}
    </select>

    <select id="findById" resultType="User">
        select *
        from user
        where id = #{id}
    </select>

    <!-- 分页可筛选查询全部用户 -->
    <select id="findPage" resultType="User">

        SELECT *
        FROM user

        <where>

            <if test="dto.username != null
              and dto.username != ''">

                AND username LIKE CONCAT('%',
                #{dto.username},
                '%')

            </if>


            <if test="dto.role != null
              and dto.role != ''">

                AND role = #{dto.role}

            </if>


            <if test="dto.status != null">

                AND status = #{dto.status}

            </if>

        </where>


        ORDER BY create_time DESC


        LIMIT #{offset}, #{dto.pageSize}

    </select>


    <!--统计数量    -->
    <select id="count" resultType="long">

        SELECT COUNT(*)
        FROM user

        <where>

            <if test="dto.username != null
              and dto.username != ''">

                AND username LIKE CONCAT('%',
                #{dto.username},
                '%')

            </if>


            <if test="dto.role != null
              and dto.role != ''">

                AND role = #{dto.role}

            </if>


            <if test="dto.status != null">

                AND status = #{dto.status}

            </if>

        </where>

    </select>


    <!-- 修改状态 -->
    <update id="updateStatus">

        UPDATE user
        SET status = #{status}
        WHERE id = #{id}

    </update>


    <!-- 修改角色 -->
    <update id="updateRole">

        UPDATE user
        SET role = #{role}
        WHERE id = #{id}

    </update>
</mapper>
